      const x = (point.x - position.x) / scale;
      const y = (point.y - position.y) / scale;
      
      const worldX = Math.round(x / PIXELS_PER_METER * 2) / 2;
      const worldY = Math.round(y / PIXELS_PER_METER * 2) / 2;
      
      const newSupport: PipeSupport = {
