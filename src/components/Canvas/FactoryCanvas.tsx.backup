          { x: lastPole.x, y: lastPole.y },
          { x: worldX, y: worldY },
          isShiftPressed,
          isCtrlPressed
        );
        worldX = constrainedPos.x;
        worldY = constrainedPos.y;
      }
      
      // Snap to grid
      worldX = Math.round(worldX * 2) / 2;
      worldY = Math.round(worldY * 2) / 2;
      
      const newPole: ConveyorPole = {
